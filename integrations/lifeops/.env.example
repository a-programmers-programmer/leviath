# Example values only. Do not commit the configured .env file.
# Publish the adapter on a separate HTTPS origin. This is NOT an existing endpoint.
LIFEOPS_PUBLIC_URL=https://lifeops-mcp.example.com
LIFEOPS_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
LIFEOPS_GOOGLE_CLIENT_SECRET=replace-through-host-secret-manager
LIFEOPS_ALLOWED_EMAILS=operator@example.com
LIFEOPS_JWT_SIGNING_KEY=replace-with-a-stable-random-key-of-at-least-32-characters
# Generate separately with cryptography.fernet.Fernet.generate_key().
LIFEOPS_STORAGE_ENCRYPTION_KEY=replace-with-generated-fernet-key
LIFEOPS_STATE_DIR=/state
LIFEOPS_DESK_URL=https://assets.byparlour.com
XELOR_SYNC_TOKEN=replace-through-host-secret-manager
LEVIATH_API_URL=http://127.0.0.1:3000
LEVIATH_API_TOKEN=replace-through-host-secret-manager
LIFEOPS_PROJECTS_JSON={"leviath":"/data/work/leviath"}
LIFEOPS_BLUEPRINTS=qwen-worker,fixer
# Start in inspection mode. Operator enables mutation tools after deployment review.
LIFEOPS_ENABLE_WRITES=0
LIFEOPS_UNATTENDED=0
PORT=8000
